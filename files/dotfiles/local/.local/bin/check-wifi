#!/bin/bash

is_connected_to_wifi() {
    ping -c3 -W1 1.1.1.1 > /dev/null 2>&1
    return $?
}

notify_no_internet() {
    notify-send " No Wi-Fi connection detected. Click to connect" -u critical
}

check_internet_connection() {
    if ! is_connected_to_wifi; then
        notify_no_internet
    fi
}

check_internet_connection